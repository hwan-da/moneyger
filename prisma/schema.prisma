generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id         BigInt    @id @default(autoincrement())
  name       String    @db.VarChar(20)
  email      String    @unique @db.VarChar(50)
  provider   String    @db.VarChar(10)
  providerId String    @db.VarChar(20)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  accounts   Account[]

  @@map("users")
}

model Account {
  id           BigInt        @id @default(autoincrement())
  userId       BigInt
  name         String        @db.VarChar(50)
  type         String        @db.VarChar(20)
  currency     String        @db.VarChar(30) // 원화/달러
  isActive     String        @db.VarChar(30) // 활성/비활성
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  user         User          @relation(fields: [userId], references: [id])
  holdings     Holding[]
  transactions Transaction[]

  @@map("accounts")
}

model Holding {
  id           BigInt        @id @default(autoincrement())
  accountId    BigInt
  symbol       String        @db.VarChar(10)
  name         String        @db.VarChar(20)
  quantity     Int
  avgPrice     Int
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  account      Account       @relation(fields: [accountId], references: [id])
  transactions Transaction[]

  @@map("holdings")
}

model Transaction {
  id        BigInt   @id @default(autoincrement())
  accountId BigInt
  holdingId BigInt?
  type      String   @db.VarChar(30) // BUY/SELL/WITHDRAW/DEPOSIT
  amount    Int?
  quantity  Int?
  price     Int?
  date      DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  account   Account  @relation(fields: [accountId], references: [id])
  holding   Holding? @relation(fields: [holdingId], references: [id])

  @@map("transactions")
}
